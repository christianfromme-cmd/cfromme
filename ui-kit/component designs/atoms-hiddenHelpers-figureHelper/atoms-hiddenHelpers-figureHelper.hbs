
<figure class="image image-semantic media-align-- media-fill--out">
    <picture><!--[if IE 9]><video style="display: none;"><![endif]-->
        <source
            srcset="{{#if image}}{{#if image}}{{image}}{{else}}/images/sample-image-01.png{{/if}}{{else}}/images/sample-image-01.png{{/if}}"
            media="( max-width: 479px )">
        <source srcset="{{#if image}}{{image}}{{else}}/images/sample-image-01.png{{/if}}"
            media="( min-width: 480px ) AND ( max-width: 799px )">
        <source srcset="{{#if image}}{{image}}{{else}}/images/sample-image-01.png{{/if}}"
            media="( min-width: 800px ) AND ( max-width: 1279px )">
        <source srcset="{{#if image}}{{image}}{{else}}/images/sample-image-01.png{{/if}}" media="( min-width: 1280px )">
        <img src="{{#if image}}{{image}}{{else}}/images/sample-image-01.png{{/if}}"
            alt=""><!--[if IE 9]></video><![endif]-->
    </picture>
   
    <figcaption class="image-caption">{{#if caption}}{{caption}}{{/if}}</figcaption>
</figure>