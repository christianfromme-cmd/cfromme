<section data-tpl="grid-bas-05"
         class="{{bas05CssClasses}}">
    {{> atoms-energywaves showEnergywaves=showEnergywaves }}

    <div class="container">
        <div class="row">
            {{#if bas05IsDemo}}
                {{> atoms-colHelper colHelperGridClasses="col-md-4" colHelperNumber="1" colHelperDemoItemName="col-md-4"}}
                {{> atoms-colHelper colHelperGridClasses="col-md-4" colHelperNumber="2" colHelperDemoItemName="col-md-4"}}
                {{> atoms-colHelper colHelperGridClasses="col-md-4" colHelperNumber="3" colHelperDemoItemName="col-md-4"}}
            {{else}}
                {{> @partial-block }}
            {{/if}}
        </div>
    </div>
</section>