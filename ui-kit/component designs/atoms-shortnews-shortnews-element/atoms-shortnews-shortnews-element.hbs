<div class="slider-element {{shortNewsDateDisabledClass}} {{shortNewsShowHideItemInitiallyClass}}">
    <div class="slider-element__content">
        <div class="short-news-date {{shortNewsDateDisabledClass}}">
            {{shortNewsElementNewsDate}}
        </div>

        <div class="slider-element__content--horizontal">
            <div class="slider-element__content--vertical">
                <h4>{{shortNewsElementHeadline}}</h4>
                <div class="text-wrapper">
                    <div class="description-text">
                        <p class="initial-height">{{shortNewsElementDescription}}</p>
                    </div>
                    
                    <div class="modal-btn"
                         data-id="autogenerate-{{shortNewsElementUniqueID}}"
                         data-lang="de-DE">
                    </div>
                </div>


                {{#if linkUrl}}
                    <a class="{{shortNewsElementButtonColor}} btn button-component__button button-component__button--link slider-element__content--button"
                       href="{{shortNewsElementLinkUrl}}"
                       target="">{{shortNewsElementCtaButtonLabel}}</a>
                {{/if}}

            </div>

            {{#if shortNewsElementImageUrl}}
                <div class="slider-element__image">
                    <div class="short-news-image"
                         style="background-image: url('{{shortNewsElementImageUrl}}')"></div>
                </div>
            {{/if}}
        </div>
    </div>

</div>

