
<div class="field-group">
    <label for="{{ffTextUniqueFieldName}}"
           class="">{{ffTextLabel}} {{#if ffTextIsRequired}}*{{/if}}</label>
    <div class="field-group__container field-group__container--has-outer">
        <label class="form-control__container">
            <input id="{{ffTextUniqueFieldName}}"
                   name="{{ffTextUniqueFieldName}}"
                   class="form-control__field"
                   type="text"
                   autocorrect="off"
                   spellcheck="false"
                   value=""
                   maxlength="255"
                   placeholder=""
                   data-sc-tracking=""
                   data-sc-field-name=""
                   data-sc-field-key=""
                   data-val-required=""
                   data-val="">
            <div class="form-control__btns"></div>
        </label>
        
        <div class="field-group__btns field-group__btns--outer">
        </div>
    </div>
    {{#unless ffTextShowErrorMessage}}
        <span class="field-validation-valid error-block"
              data-valmsg-for="{{ffTextUniqueFieldName}}"
              data-valmsg-replace="true"></span>
    {{else}}
        <span class="error-block field-validation-error"
              data-valmsg-for="{{ffTextUniqueFieldName}}"
              data-valmsg-replace="true">
            Value * is required.</span>
    {{/unless}}
</div>